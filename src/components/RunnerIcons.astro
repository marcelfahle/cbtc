    <symbol id="i-flask" viewBox="0 0 24 24"><path d="M10 3h4v2.5c1.2.8 2 2 2 3.5v9a3 3 0 0 1-3 3h-2a3 3 0 0 1-3-3V9c0-1.5.8-2.7 2-3.5V3z"/><path d="M9 14h6"/></symbol>
