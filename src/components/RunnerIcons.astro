    <!-- Feet -->
    <symbol id="i-shoe" viewBox="0 0 24 24"><path d="M22 9.5c0-.8-.7-1.5-1.5-1.5h-2.3c-.9 0-1.7.4-2.3 1L12.5 12c-2.7.3-5.3 1.2-7.8 2.6C3.5 15.3 2.5 16.6 2.5 18v.5H22v-9z"/><path d="M15.5 10.5l-1.7 1.6M14 9.3l-1.7 1.6"/><path d="M2.5 15.5h19.5"/><path d="M4.5 21h1.5M8.5 21h1.5M12.5 21h1.5M16.5 21h1.5M20 21h1"/></symbol>
