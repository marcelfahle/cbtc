---
// /camp/2027/02/qa: sign-up page for the four live Q&A sessions before the February camp.
// Unlisted (noindex), sent by email to the people who asked for details. One job: pick an
// evening, leave name and email. Sessions live in public/scripts/qa-sessions.js, the RSVP
// lands in /api/rsvp. Design follows homepage v2 (fonts, tokens, ticket stubs), kept short.
import { sessions, camp, DURATION_MIN } from '../../../../../public/scripts/qa-sessions.js';

const title = 'Live Q&A before the February camp · Costa Blanca Trail Camp';
const description = 'Four live, small-group Q&A sessions on Google Meet with Monika and Anna about the 2–7 February 2027 camp. Pick an evening, get the link and a calendar invite.';
const url = camp.page;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content="noindex, follow">
<link rel="canonical" href={url}>
<meta property="og:type" content="website"><meta property="og:site_name" content="Costa Blanca Trail Camp"><meta property="og:title" content="Live Q&A before the February camp"><meta property="og:description" content={description}><meta property="og:url" content={url}><meta property="og:image" content="https://www.costablancatrailcamp.com/images/og-sunrise.jpg">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#F8F3E8">
<link rel="icon" href="/favicon.ico" sizes="48x48"><link rel="icon" type="image/svg+xml" href="/favicon.svg"><link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preload" href="/fonts/Archivo-var.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/SourceSans3-var.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/Newsreader-italic-var.woff2" as="font" type="font/woff2" crossorigin>
<style is:global>
@font-face{font-family:"Archivo";src:url("/fonts/Archivo-var.woff2") format("woff2");font-weight:100 900;font-display:swap}
@font-face{font-family:"Source Sans 3";src:url("/fonts/SourceSans3-var.woff2") format("woff2");font-weight:200 900;font-display:swap}
@font-face{font-family:"Newsreader";src:url("/fonts/Newsreader-italic-var.woff2") format("woff2");font-weight:200 800;font-style:italic;font-display:swap}

:root{
  --ivory:#F8F3E8; --paper:#FFFCF4; --sand:#F1E5CB; --sage:#DDE5D2;
  --forest:#14281D; --forest-2:#3A4A3F; --forest-3:#5A6A5C;
  --ochre:#7A5512; --sun:#F2C14E; --terra:#9B482E; --terra-deep:#77351F;
  --line:rgba(20,40,29,.16);
  --wrap:clamp(16px,5vw,72px);
  --ease:cubic-bezier(.22,1,.36,1);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{font-family:"Source Sans 3",system-ui,sans-serif;font-size:clamp(17px,1.05vw + 12px,19px);line-height:1.5;color:var(--forest);background:var(--ivory);overflow-x:clip}
img,svg{display:block;max-width:100%}
a{color:inherit}
h1,h2,h3{font-family:"Archivo",sans-serif;letter-spacing:-.025em;line-height:1;font-weight:800;text-wrap:balance}
h1 em{font-family:"Newsreader",serif;font-style:italic;font-weight:500;letter-spacing:-.015em;color:var(--ochre)}
p{text-wrap:pretty}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.kicker{display:inline-flex;align-items:center;gap:12px;font-family:"Archivo";font-weight:800;font-size:13px;letter-spacing:.16em;text-transform:uppercase;color:var(--ochre)}
.kicker::before{content:"";flex:none;width:18px;height:12px;border-radius:2px;background:linear-gradient(#fff 0 50%,var(--sun) 50% 100%);box-shadow:0 0 0 1px rgba(20,40,29,.22)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5em;min-height:52px;padding:.8em 1.5em;border-radius:999px;border:0;font:inherit;font-weight:700;font-size:1rem;line-height:1.1;text-decoration:none;cursor:pointer;background:var(--terra);color:#FFF8F0;transition:background .2s,transform .3s var(--ease)}
.btn:hover{background:var(--terra-deep);transform:translateY(-2px)}
.btn:active{transform:translateY(0)}
.btn[disabled]{opacity:.7;cursor:progress;transform:none}
.btn.ghost{background:transparent;color:var(--forest);box-shadow:inset 0 0 0 1.5px rgba(20,40,29,.4)}
.btn.ghost:hover{background:rgba(20,40,29,.06);box-shadow:inset 0 0 0 1.5px var(--forest)}
.btn:focus-visible,a:focus-visible,input:focus-visible,button:focus-visible,textarea:focus-visible{outline:3px solid var(--ochre);outline-offset:3px}

/* Shell */
.page{max-width:72rem;margin-inline:auto;padding:0 var(--wrap) clamp(48px,6vw,80px)}
.top{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px 0}
.brand{display:flex;align-items:center;gap:12px;font-family:"Archivo";font-weight:800;font-size:15px;line-height:1.05;letter-spacing:.03em;text-transform:uppercase;text-decoration:none;max-width:12em}
.brand img{width:42px;height:42px;flex:none}
.top a.back{font-size:15px;font-weight:600;text-decoration:none;color:var(--forest-2)}
.top a.back:hover{color:var(--forest);text-decoration:underline;text-underline-offset:.2em}
@media(max-width:600px){.brand{font-size:12px;gap:8px}.brand img{width:34px;height:34px}}

/* Head */
.head{padding:clamp(28px,5vw,64px) 0 clamp(28px,4vw,44px);max-width:46rem}
.head h1{font-size:clamp(36px,5.6vw,72px);font-weight:900;text-transform:uppercase;letter-spacing:-.04em;line-height:.92;margin-top:16px;text-wrap:initial}
.head h1 em{display:block;text-transform:none;line-height:1.05;padding-left:.03em}
.head .lede{font-size:clamp(18px,1.5vw,22px);color:var(--forest-2);margin-top:20px;max-width:30em}
.hosts{display:flex;align-items:center;gap:14px;margin-top:22px;font-size:15px;color:var(--forest-2)}
.hosts .faces{display:flex;flex:none}
.hosts img{flex:none;width:44px;height:44px;border-radius:50%;object-fit:cover;box-shadow:0 0 0 2.5px var(--paper),0 6px 16px -8px rgba(20,40,29,.6)}
.hosts img+img{margin-left:-10px}
.hosts b{color:var(--forest)}

/* Two columns: the pick on the left, the short version on the right */
.grid{display:grid;gap:clamp(28px,4vw,56px);align-items:start}
@media(min-width:60rem){.grid{grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr)}.grid .side{position:sticky;top:32px}}

/* The four stubs */
/* Three shared columns across all four stubs (subgrid) so the dashed line sits on one vertical */
.slots{display:grid;grid-template-columns:auto 1fr auto;gap:12px;border:0}
.slots legend{grid-column:1/-1}
.slots legend{font-weight:700;margin-bottom:12px}
.slot{position:relative;display:grid;grid-column:1/-1;grid-template-columns:subgrid;align-items:stretch;min-height:84px;background:var(--paper);border-radius:14px;cursor:pointer;
  box-shadow:0 1px 0 rgba(255,255,255,.8) inset,0 1px 2px rgba(20,40,29,.06),0 14px 30px -22px rgba(20,40,29,.5);transition:transform .35s var(--ease),box-shadow .35s var(--ease),background .25s}
.slot:hover{transform:translateY(-2px);box-shadow:0 1px 0 rgba(255,255,255,.8) inset,0 1px 2px rgba(20,40,29,.06),0 18px 34px -22px rgba(20,40,29,.55)}
.slot input{position:absolute;opacity:0;width:1px;height:1px}
.slot .day{display:grid;align-content:center;padding:12px 20px 12px 24px;border-right:1.5px dashed rgba(20,40,29,.25);min-width:9.5em}
.slot .day b{font-family:"Archivo";font-weight:900;font-size:clamp(21px,2vw,27px);letter-spacing:-.03em;line-height:.95;text-transform:uppercase}
.slot .day small{display:block;margin-top:3px;font-size:15px;color:var(--forest-2)}
.slot .tag{display:inline-block;margin-left:6px;vertical-align:1px;font-family:"Archivo";font-weight:800;font-size:10px;letter-spacing:.12em;text-transform:uppercase;background:var(--sun);color:var(--forest);padding:3px 7px 2px;border-radius:999px}
.slot .when{display:grid;align-content:center;gap:2px;padding:12px 18px}
.slot .when b{font-family:"Archivo";font-weight:800;font-size:19px;letter-spacing:-.01em;white-space:nowrap}
.slot .when b span{font-weight:600;font-size:15px;color:var(--forest-3);margin-left:.4em}
.slot .when small{font-size:14px;color:var(--ochre);font-weight:600}
.slot .go{display:grid;place-items:center;padding:0 20px 0 16px}
.slot .ring{width:26px;height:26px;border-radius:50%;box-shadow:inset 0 0 0 2px rgba(20,40,29,.35);display:grid;place-items:center;transition:box-shadow .2s,background .2s}
.slot .ring::after{content:"";width:11px;height:11px;border-radius:50%;background:var(--paper);transform:scale(0);transition:transform .3s var(--ease)}
.slot:has(input:checked){background:#FFF6E2;box-shadow:0 0 0 2px var(--terra),0 16px 34px -22px rgba(20,40,29,.5)}
.slot:has(input:checked) .ring{background:var(--terra);box-shadow:none}
.slot:has(input:checked) .ring::after{transform:scale(1)}
.slot:has(input:focus-visible){outline:3px solid var(--ochre);outline-offset:3px}
.slot.faded{opacity:.42;pointer-events:none}
.slot.chosen{pointer-events:none}
@media(max-width:560px){.slots{grid-template-columns:1fr}.slot{grid-template-columns:1fr auto}.slot .day{border:0;padding:14px 16px 2px 20px;min-width:0}.slot .when{grid-column:1;padding:0 16px 14px 20px}.slot .go{grid-column:2;grid-row:1/3;padding:0 16px}}
.zone{margin-top:12px;font-size:14px;color:var(--forest-3)}

/* The form: boxed inputs so label, box and hint read as one unit */
.card{position:relative;background:var(--paper);border-radius:6px;padding:clamp(28px,3vw,40px) clamp(20px,3vw,36px) clamp(24px,2.5vw,32px);box-shadow:0 1px 2px rgba(20,40,29,.08),0 30px 60px -40px rgba(20,40,29,.5);margin-top:28px}
.card::before{content:"";position:absolute;top:-14px;left:50%;width:120px;height:30px;transform:translateX(-50%) rotate(-2deg);background:rgba(242,193,78,.55);box-shadow:0 1px 2px rgba(20,40,29,.1)}
form{display:grid;gap:0}
.card{display:grid;gap:22px}
.card[hidden],form[hidden],[hidden]{display:none}
.field{display:grid;gap:8px}
.field label{font-weight:700;line-height:1.2}
.field label span{font-weight:400;color:var(--forest-3)}
.field input,.field textarea{width:100%;font:inherit;font-size:max(16px,1rem);min-height:54px;padding:13px 16px;border:1.5px solid rgba(20,40,29,.28);border-radius:12px;background:#fff;color:var(--forest);transition:border-color .2s,box-shadow .2s;resize:vertical}
.field textarea{min-height:88px;line-height:1.45}
.field input:hover,.field textarea:hover{border-color:rgba(20,40,29,.55)}
.field input:focus-visible,.field textarea:focus-visible{outline:none;border-color:var(--terra);box-shadow:0 0 0 3px rgba(155,72,46,.18)}
.field ::placeholder{color:#8A8D80}
.form-foot{display:grid;gap:12px;margin-top:4px}
.form-foot .btn{width:100%;min-height:56px;font-size:1.05rem}
.form-foot .fine{font-size:.92rem;color:var(--forest-3);text-align:center}
.form-foot a{text-decoration:underline;text-underline-offset:.2em}
.honeypot{position:absolute;left:-9999px;width:0;height:0;opacity:0}
[data-error],[data-pick-nudge]{color:#9B2C12;font-weight:600}
[data-pick-nudge]{margin-top:12px}

/* Done */
.done{outline:none;gap:0}
.done>*{justify-self:start}
.done .stamp{display:inline-block;font-family:"Archivo";font-weight:900;font-size:13px;letter-spacing:.16em;text-transform:uppercase;color:var(--terra);border:2.5px solid currentColor;border-radius:6px;padding:6px 10px;transform:rotate(-3deg);margin-bottom:16px}
.done h2{font-family:"Newsreader",serif;font-style:italic;font-weight:500;font-size:clamp(26px,2.4vw,34px);letter-spacing:-.01em;line-height:1.15}
.done p{margin-top:12px;color:var(--forest-2)}
.done .acts{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}
.done .acts .btn{min-height:46px;font-size:15px}
.done .fine{font-size:.92rem;color:var(--forest-3);margin-top:16px}

/* The short version */
.side{display:grid;gap:26px;font-size:clamp(16px,1.15vw,18px);color:var(--forest-2)}
.side h2{font-size:14px;font-family:"Archivo";font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--ochre);margin-bottom:10px}
.side ul{list-style:none;display:grid}
.side li{padding:9px 0 9px 26px;border-top:1px solid var(--line);position:relative}
.side li:last-child{border-bottom:1px solid var(--line)}
.side li::before{content:"";position:absolute;left:4px;top:18px;width:8px;height:8px;border-radius:50%;background:var(--sun);box-shadow:0 0 0 3px rgba(242,193,78,.3)}
.side p+p{margin-top:8px}
.side b{color:var(--forest)}
.side a{text-decoration:underline;text-underline-offset:.2em}

footer{border-top:1px solid var(--line);margin-top:clamp(40px,6vw,72px);padding-top:22px;font-size:14px;color:var(--forest-3);display:flex;flex-wrap:wrap;gap:8px 24px;justify-content:space-between}
footer a{text-decoration:none}
footer a:hover{text-decoration:underline;text-underline-offset:.2em}

@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{transition-duration:.01ms!important}}
</style>
<script async src="https://plausible.io/js/pa-Ph375L-pQZDyOfoQSaRdy.js"></script><script is:inline>window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)};plausible.init=plausible.init||function(i){plausible.o=i||{}};plausible.init()</script>
</head>
<body>
<div class="page">

<div class="top">
  <a class="brand" href="/"><img src="/images/mark.svg" alt="" width="42" height="42">Costa Blanca Trail Camp</a>
  <a class="back" href="/#camps">The camps</a>
</div>

<header class="head">
  <p class="kicker">{camp.name} · {camp.window} · Live Q&A</p>
  <h1>Ask us anything <em>before you decide</em></h1>
  <p class="lede">Four live group calls over the next two weeks, {DURATION_MIN} minutes each, same content every time. We walk you through the February week, then it’s your questions. Pick an evening and we’ll send the link and a calendar invite.</p>
  <div class="hosts">
    <div class="faces"><img src="/images/monika.webp" alt="Monika Fahle" width="44" height="44"><img src="/images/anna.webp" alt="Anna Berglind Pálmadóttir" width="44" height="44"></div>
    <p><b>With Monika and Anna,</b> who are on the trails with you in February.</p>
  </div>
</header>

<div class="grid">
  <div>
    <form data-rsvp novalidate>
      <fieldset class="slots">
        <legend>Pick the evening that fits. All at 19:00 Spain time.</legend>
        {sessions.map(s => (
          <label class="slot">
            <input type="radio" name="session" value={s.id} />
            <span class="day"><b>{s.weekday}</b><small>{s.day} {s.month}{s.tag && <span class="tag">{s.tag}</span>}</small></span>
            <span class="when"><b>{s.time}<span>{s.tz}, Spain</span></b><small data-local={s.id}></small></span>
            <span class="go"><span class="ring" aria-hidden="true"></span></span>
          </label>
        ))}
      </fieldset>
      <p class="zone">Where your local time differs, it shows under each date.</p>
      <p data-pick-nudge role="alert" hidden>Choose one of the four evenings first.</p>

      <div class="card">
        <div class="field">
          <label for="name">Your name</label>
          <input id="name" name="name" type="text" autocomplete="name" required placeholder="First name is fine" />
        </div>
        <div class="field">
          <label for="email">Email <span>for the link and the invite</span></label>
          <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required placeholder="you@example.com" />
        </div>
        <div class="field">
          <label for="question">One thing you want answered <span>optional</span></label>
          <textarea id="question" name="question" rows="2" placeholder="The climbs, the rooms, flights, anything"></textarea>
        </div>
        <label class="honeypot" aria-hidden="true">Website <input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
        <div class="form-foot">
          <button class="btn" type="submit">Save my seat</button>
          <p data-error role="alert" hidden></p>
          <p class="fine">The Google Meet link and a calendar invitation reach your inbox within a minute. Nothing to pay, nothing to decide yet. <a href="/privacy">Privacy</a>.</p>
        </div>
      </div>
    </form>

    <div class="card done" id="done" tabindex="-1" role="status" aria-live="polite" hidden>
      <span class="stamp">Seat saved</span>
      <h2>See you on <span data-done-when></span></h2>
      <p>The link and the invitation are on their way to <b data-done-email></b>. Put it in your calendar now so the week doesn’t swallow it.</p>
      <div class="acts">
        <a class="btn" data-gcal href="#" target="_blank" rel="noopener">Add to Google Calendar</a>
        <a class="btn ghost" data-ics href="#">Apple or Outlook (.ics)</a>
        <a class="btn ghost" data-zoom href="#" target="_blank" rel="noopener" hidden>Open the Meet link</a>
      </div>
      <p class="fine">Date stops working? Reply to the confirmation email and we’ll move you to another evening.</p>
    </div>
  </div>

  <aside class="side">
    <div>
      <h2>On the call</h2>
      <ul>
        <li>The week day by day, Tuesday arrival to Sunday flight</li>
        <li>The trails: distance, climbing, the rocky bits we hike</li>
        <li>Who the camp fits, and who should wait a year</li>
        <li>Rooms, prices, what’s included, getting to Dénia</li>
        <li>Your questions, as many as you have</li>
      </ul>
    </div>
    <div>
      <h2>After the call</h2>
      <p>The next morning you get an email with the details and the answers that came up. <b>If it’s a yes,</b> you reply “I’m in” and we send a deposit link. The group is small, so places go in the order deposits arrive. If it’s a no, that’s a good outcome too.</p>
      <p><b>Can’t make any of the four?</b> Email <a href="mailto:hello@costablancatrailcamp.com?subject=Q%26A%20another%20time">hello@costablancatrailcamp.com</a> and we’ll find a time.</p>
    </div>
  </aside>
</div>

<footer>
  <span>Costa Blanca Trail Camp · {camp.window} · Dénia, Spain</span>
  <span><a href="https://www.instagram.com/costablancatrailcamp/">@costablancatrailcamp</a> · <a href="/privacy">Privacy</a></span>
</footer>

</div>
<script type="module" src="/scripts/qa.js"></script>
<script src="/scripts/meta-pixel-consent.js" defer></script>
</body>
</html>
