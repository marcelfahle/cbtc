{
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(images|media)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/camp/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/checklist",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/routes/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/hero-gallery/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/checklist/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/routes/benigembla/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/camp/2027/02/qa/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/hero-gallery/",
      "destination": "/",
      "permanent": false
    }
  ]
}
